'KakeyaPalomar.sharpMaximalBound' depends on axioms: [propext, Classical.choice, Quot.sound]
'KakeyaPalomar.sharpTubeBound' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem KakeyaPalomar.sharpMaximalBound : ∀ {n : ℕ},
  2 ≤ n →
    ∃ C,
      0 < C ∧
        ∀ (δ : ℝ),
          0 < δ →
            δ ≤ 1 →
              ∀ (f : KakeyaPalomar.Space n → ℂ),
                MeasureTheory.MemLp f (↑n) MeasureTheory.volume →
                  MeasureTheory.MemLp (KakeyaPalomar.kakeyaMaximal δ f) (↑n) (KakeyaPalomar.sphereMeasure n) ∧
                    MeasureTheory.eLpNorm (KakeyaPalomar.kakeyaMaximal δ f) (↑n) (KakeyaPalomar.sphereMeasure n) ≤
                      ENNReal.ofReal (C * Real.log (2 / δ) ^ ((↑n - 1) / ↑n)) *
                        MeasureTheory.eLpNorm f (↑n) MeasureTheory.volume :=
<not imported>
theorem KakeyaPalomar.sharpTubeBound : ∀ {n : ℕ},
  2 ≤ n →
    ∃ C,
      0 < C ∧
        ∀ (m : ℕ) (δ : ℝ),
          0 < δ →
            δ ≤ 1 →
              ∀ (v x : Fin m → KakeyaPalomar.Space n),
                (∀ (i : Fin m), ‖v i‖ = 1) →
                  (∀ (i j : Fin m), i ≠ j → δ ≤ dist (v i) (v j)) →
                    ∀ (a : Fin m → ℝ),
                      (∀ (i : Fin m), 0 ≤ a i) →
                        ∫ (y : KakeyaPalomar.Space n),
                            (∑ i, (KakeyaPalomar.tube (2 * δ) (v i) (x i)).indicator (fun x => a i) y) ^
                              (↑n / (↑n - 1)) ≤
                          C * Real.log (2 / δ) * δ ^ (n - 1) * ∑ i, a i ^ (↑n / (↑n - 1)) :=
<not imported>
